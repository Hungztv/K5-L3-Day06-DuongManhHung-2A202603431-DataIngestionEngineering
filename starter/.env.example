# Embedding model local (không cần API key)
# Model all-MiniLM-L6-v2 nhẹ (~90MB), 384 chiều, chạy tốt trên CPU
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Thư mục lưu ChromaDB (tương đối từ starter/)
CHROMA_DIR=chroma_db

# Nếu muốn dùng API thay local embeddings:
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
